# AWS EC2 MIH environment variables:
EC2_DASHED_PUBLIC_IP = 18-192-3-141
EC2_PUBLIC_DNS = ec2-${EC2_DASHED_PUBLIC_IP}.eu-central-1.compute.amazonaws.com
PEM_KEY_PATH = ../honey-cloud-key.pem

# DigitalOcean MIH environment variables:
DROPLET_EXTERNAL_IP = 165.245.213.213
# Droplet SSH key has no file extension, so don't add one!
SSH_KEY_PATH = %USERPROFILE%\\.ssh\\ollama_llmpot

# same user exists for both AWS and DO, and can be reused for all such SSH connections
CLOUD_USER = ubuntu

# path to the config folder containing the OpenVPN files, including the .key file:
# (only needed for access to the DTU-hosted honeypot)
OPENVPN_KEY_CONFIG_PATH = %USERPROFILE%\\OpenVPN\\config\\
PROXY_RELATIVE_KEY_PATH = ~/.ssh/id_ed25519
NESTED_VM_USER = hpu
DTU_VM_HOSTNAME = ollama-mh

HOST_LOG_DIR = D:\\MScProj_logs
# HOST_LOG_DIR = C:\\MScProj_logs

HP_CONTAINER_NAME = honey-llm
TCPDUMP_CONTAINER_NAME = tcpdump-container
HP_IMAGE_NAME = nikriin/honey-llm-image:mihv8
BASE_LOG_DIRECTORY_NAME = /honey-llm-logs

# TODO: change this path to account for the Dockerfile's WORKDIR,
# TODO: or change both files to instead have a WORKDIR environment variable and a LOG_DIR environment variable!
CONTAINER_LOG_PATH = /app/logs

# ! note that the filename here is purposefully NOT included, as that is prepended. This is to make the bot code more flexible (mainly to more easily include a timestamp when copying the log file)
CONTAINER_LOG_FILE_NAME = in-out
