# A .env file for environment variables used in the honeypot code
# ! MIGHT BE IMPORTANT TO MAKE SURE THE MODELs HERE CONTAIN BOTH THEIR NAME AND PARAMETER COUNT,
# ! SINCE THE utils.py CODE ASSUMES THEM TO EXIST AND MIGHT BREAK OR USE WEIRD VALUES IF THE MODEL NAME FORMATS AREN'T CORRECT

MODEL_LIST = ["qwen3.6:35b", "llama3.1:70b", "mistral:7b"]

# Ollama seems to only support one running model at a time
# (at least on my own host machine, might be different for server hosting?)
# TODO: Though Ollama seems to only have one running model at a time, its API responses still uses a list of running models, which then often just contains one singular model
RUNNING_MODEL = "llama3.1:70b"

# determine whether or not to log the headers of incoming requests:
LOG_HEADERS = false